#!/bin/bash
# Zendure SolarFlow - uninstall
# command <TEMPFOLDER> <NAME> <FOLDER> <VERSION> <BASEFOLDER>
#
# Wird von LoxBerry als root ausgefuehrt. Rueckgabewert 0 = in Ordnung,
# 1 = Warnung (die Deinstallation laeuft trotzdem weiter).
#
# ===================================================================
# WARUM ES DIESE DATEI GIBT
# ===================================================================
#
# LoxBerry raeumt die Plugin-Ordner weg (config/, data/, log/, bin/) und
# entfernt den Cron-Eintrag. Zwei Dinge bleiben sonst liegen:
#
#   1. config/plugins/<ordner>.backup.json
#      Die Sicherung der Konfiguration liegt bewusst NEBEN dem Konfigordner,
#      damit sie Update und Neuinstallation uebersteht (preupgrade.sh legt
#      sie an). Beim Deinstallieren ist genau das falsch: darin steht das
#      AKTIONSTOKEN, mit dem sich der Speicher ueber den unangemeldeten
#      Endpunkt laden, entladen und begrenzen laesst - und, sofern
#      eingetragen, die Zugangsdaten des MQTT-Brokers.
#   2. Ein noch laufender Dienst. Er haelt eine MQTT-Verbindung offen und
#      wuerde ins Leere weiterlaufen.
#
# Einen Arbeitsordner auf der Ramdisk gibt es nicht - dieses Plugin legt
# alles unter data/plugins/<ordner> ab, und das raeumt LoxBerry selbst weg.
#
# ZUR PROZESSSUCHE: "pkill -f zendure_dienst.php" waere zu grob. Verglichen
# wird argumentweise gegen den vollen Pfad.

PDIR=$3
[ -n "$PDIR" ] || PDIR="zendure"
BASE="${5:-$LBHOMEDIR}"
# Dritter Rueckfall: der eigene Ablageort. Bewusst kein fest verdrahteter
# Systempfad - LoxBerry laesst sich anderswohin installieren, und der
# Plugin-Pruefer sucht die Zeichenkette, ohne den Zusammenhang zu sehen.
# Dieses Skript liegt unter <home>/data/plugins/<ordner>/uninstall/
if [ -z "$BASE" ] || [ ! -d "$BASE" ]; then
    BASE=$(cd "$(dirname "$(readlink -f "$0")")/../../../.." 2>/dev/null && pwd)
fi

SKRIPT="$BASE/bin/plugins/$PDIR/zendure_dienst.php"
BK="$BASE/config/plugins/$PDIR.backup.json"

# ---- 1. Dienst beenden ----
GEFUNDEN=0
for D in /proc/[0-9]*; do
    P=$(basename "$D")
    [ -r "$D/cmdline" ] || continue
    if tr '\0' '\n' < "$D/cmdline" 2>/dev/null | grep -qxF "$SKRIPT"; then
        kill "$P" 2>/dev/null
        for i in 1 2 3 4 5; do
            kill -0 "$P" 2>/dev/null || break
            sleep 1
        done
        kill -9 "$P" 2>/dev/null
        GEFUNDEN=1
        echo "<OK> Laufenden Dienst beendet (PID $P)."
    fi
done
[ "$GEFUNDEN" -eq 0 ] && echo "<INFO> Es lief kein Dienst."

# ---- 2. Sicherungen mit dem Aktionstoken ----
#
# ES SIND ZWEI, NICHT EINE. preupgrade.sh legt seit 0.9.4 zusaetzlich eine
# Zweitschrift <ordner>.backup.zendure.json an - dieselben Geheimnisse,
# anderer Name. Bis 0.9.8 entfernte dieses Skript nur die erste und meldete
# danach trotzdem, Aktionstoken und Zugangsdaten seien fort. Eine
# unzutreffende Sicherheitszusage ist schlimmer als gar keine, weil sie
# weitergegeben wird.
GEFUNDEN_BK=0
for F in "$BK" "$BASE/config/plugins/$PDIR.backup.zendure.json"; do
    [ -f "$F" ] || continue
    # Vor dem Entfernen ueberschreiben: die Datei enthaelt ein Geheimnis.
    # Das ERSCHWERT das Wiederfinden - es loescht nicht sicher. Auf
    # Speicherkarte und eMMC entscheidet der Flash-Controller selbst, wohin
    # geschrieben wird; der alte Block kann physisch stehen bleiben.
    SIZE=$(stat -c%s "$F" 2>/dev/null || echo 0)
    [ "$SIZE" -gt 0 ] && head -c "$SIZE" /dev/zero > "$F" 2>/dev/null
    rm -f "$F" && echo "<OK> Sicherung entfernt: $(basename "$F")"
    GEFUNDEN_BK=1
done
if [ "$GEFUNDEN_BK" -eq 1 ]; then
    echo "<INFO> Aktionstoken und MQTT-Zugangsdaten sind damit vom LoxBerry fort."
else
    echo "<INFO> Keine Sicherung ausserhalb des Plugin-Ordners vorhanden."
fi

# ---- 3. Bestandsordner ----
#
# Er liegt bewusst NEBEN data/plugins/<ordner>, damit Verlauf und Sollmerker
# ein Update ueberstehen - genau deshalb raeumt LoxBerry ihn nicht mit weg.
# Beim Deinstallieren ist das falsch, also hier.
PBESTAND="$BASE/data/plugins/$PDIR.bestand"
if [ -d "$PBESTAND" ]; then
    N=$(find "$PBESTAND/verlauf" -name 'geraet*_*.csv' 2>/dev/null | wc -l)
    rm -rf "$PBESTAND" && echo "<OK> Bestandsordner entfernt ($N Verlaufsdatei(en)): $PDIR.bestand"
else
    echo "<INFO> Kein Bestandsordner vorhanden."
fi

echo "<WARNING> Im MQTT-Broker koennen Werte stehen bleiben."
echo "<INFO> Das Plugin veroeffentlicht unter dem eingestellten Themenpraefix"
echo "<INFO> (Vorgabe: zendure/...). Zum Aufraeumen: LoxBerry -> System ->"
echo "<INFO> MQTT Gateway."
echo "<INFO> Der Speicher selbst bleibt unberuehrt und behaelt seine"
echo "<INFO> zuletzt gesetzten Grenzen."
exit 0
